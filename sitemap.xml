---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign langs = "nl,en" | split: "," %}
{%- for lang in langs %}
{%- assign lang_pages = site.pages | where: "lang", lang | sort: "url" %}
{%- for p in lang_pages %}
{%- assign nl_url = p.url | replace_first: '/en/', '/nl/' %}
{%- assign en_url = p.url | replace_first: '/nl/', '/en/' %}
  <url>
    <loc>{{ p.url | prepend: site.url }}</loc>
    <xhtml:link rel="alternate" hreflang="nl" href="{{ nl_url | prepend: site.url }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ en_url | prepend: site.url }}"/>
  </url>
{%- endfor %}
{%- endfor %}
</urlset>
